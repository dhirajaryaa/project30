# MongoDB connection string used by the server data layer (Mongoose).
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/project30

# MongoDB Atlas (replace with your real connection string):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/project30

# Public site URL (used for canonical URLs / OG metadata). Set on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000