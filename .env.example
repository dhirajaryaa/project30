# MongoDB connection string used by the server data layer (Mongoose).
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/project30

# MongoDB Atlas (replace with your real connection string):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/project30

# Public site URL (used for canonical URLs / OG metadata). Set on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth — session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Auth base URL (defaults to NEXT_PUBLIC_SITE_URL when unset).
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret